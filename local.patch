+     * at 0x00080000 (aliased to 0x08080000, past 256KB flash end on F103). */
+    bl    main
+
+    /* main() never returns, but WFI if it does */
+.L_loop:
+    wfi
+    b     .L_loop
+.size Reset_Handler, . - Reset_Handler
