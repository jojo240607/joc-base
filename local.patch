diff --git a/system_stm32f1xx.c b/system_stm32f1xx.c
new file mode 100644
index 0000000..f99a118
--- /dev/null
+++ b/system_stm32f1xx.c
@@ -0,0 +1,21 @@
+/*
+ * Minimal system_stm32f1xx.c for STM32F103.
+ *
+ * Provides SystemInit() which sets VTOR to the flash base.
+ * The full clock configuration is done by clock_hal_configure() in board_tick_init().
+ */
+#include "stm32f1xx.h"
+
+/* SystemCoreClock 由 clock_hal_configure() 最终设为 72000000 (HSE+PLL@72MHz) */
+uint32_t SystemCoreClock = 72000000UL;
+
+void SystemInit(void)
+{
+    /* Set vector table offset to the start of flash (0x08000000) */
+    SCB->VTOR = FLASH_BASE | 0x0000U;
+
+    /* Enable HSI (8 MHz internal RC) as fallback; the clock HAL switches
+     * to HSE+PLL=72 MHz later. No FPU on M3, so skip FPU config. */
+    RCC->CR |= RCC_CR_HSION;
+    while ((RCC->CR & RCC_CR_HSIRDY) == 0) { }
+}
\ No newline at end of file
diff --git a/tools/openocd/h750_qspi.cfg b/tools/openocd/h750_qspi.cfg
new file mode 100644
index 0000000..270be36
--- /dev/null
+++ b/tools/openocd/h750_qspi.cfg
@@ -0,0 +1,30 @@
+#
+# h750_qspi.cfg — OpenOCD board config for STM32H750B-DK system + external
+# QSPI flash programming.
+#
+# Two flash banks:
+#   bank 0: internal 128 KB flash (system: RTOS + drivers)
+#   bank 1: external W25Q128 16 MB via QUADSPI in memory-mapped mode
+#           (APP_FLASH partition, base 0x90000000)
+#
+# Requires OpenOCD >= 0.11 (stm32h7x_qspi flash driver).
+# If your OpenOCD is older/newer and the qspi bank fails, adjust the
+# `flash bank stm32h7x_qspi` line to your version's signature
+# (older: "stm32h7x_qspi <base> <size> <chip> <bus> <target> <freq> <port>").
+#
+
+source [find target/stm32h7x.cfg]
+
+# stm32h7x.cfg configures the H750 core (CPUTAPID auto-detected). Override the
+# chip name so the qspi bank binds to the right target:
+set CHIPNAME stm32h750
+
+# External QSPI flash bank (W25Q128, 16 MB @ 0x90000000, 1-line / quad IO
+# handled by the driver; QSPI clock 20 MHz to stay within any NOR's spec).
+# Signature (OpenOCD 0.11+): stm32h7x_qspi <base> <size> <chip_width>
+#                            <bus_width> <target> <freq> <port>
+flash bank qspi_flash stm32h7x_qspi 0x90000000 0 0 0 $_CHIPNAME.qspi 20000000 1
+
+# Optional: verify the bank works from the CLI:
+#   openocd -f tools/openocd/h750_qspi.cfg -c "init" \
+#           -c "flash info 1" -c "shutdown"
diff --git a/tools/renode/dump_riscv_trace.py b/tools/renode/dump_riscv_trace.py
new file mode 100644
index 0000000..04de4fb
--- /dev/null
+++ b/tools/renode/dump_riscv_trace.py
@@ -0,0 +1,119 @@
+# -*- coding: utf-8 -*-
+# RISC-V debug: dump fault record / fault frame regs / switch trace / g_running / TCB pool
+# Usage: include after the machine has crashed & paused.
+import sys, traceback
+
+OUTF = r"d:\projects\mcu\os\joc-base\tools\renode\riscv_dump.txt"
+_f = open(OUTF, "w")
+
+def out(s):
+    try:
+        sys.stdout.write(s)
+        sys.stdout.flush()
+    except Exception:
+        pass
+    try:
+        _f.write(s)
+        _f.flush()
+    except Exception:
+        pass
+
+try:
+    SB = self.Machine.SystemBus
+
+    def rd32(a):
+        try:
+            return SB.ReadDoubleWord(a)
+        except Exception:
+            return 0xDEADBEEF
+
+    def rd8(a):
+        try:
+            return SB.ReadByte(a)
+        except Exception:
+            return 0
+
+    def cstr(a, n=24):
+        s = []
+        for i in range(n):
+            c = rd8(a + i)
+            if c == 0:
+                break
+            s.append(chr(c))
+        return "".join(s)
+
+    TR_RING   = 0x3fc91638
+    TR_CNT    = 0x3fc801d4
+    SW_TRACE  = 0x3fc90634
+    SW_CNT    = 0x3fc80190
+    G_RUNNING = 0x3fc87a4c
+    G_TASK_POOL = 0x3fc87a50
+    FAULT     = 0x3fc801c4   # mtval, mepc, mcause, count
+
+    out("\n===== fault record =====\n")
+    fcnt  = rd32(FAULT + 12)
+    fmc   = rd32(FAULT + 8)
+    fmepc = rd32(FAULT + 4)
+    fmtval = rd32(FAULT + 0)
+    out("  count=%d mcause=0x%08X mepc=0x%08X mtval=0x%08X\n" % (fcnt, fmc, fmepc, fmtval))
+    if fmc == 4:   # load address misaligned -> mtval = faulting addr = 4 + s1
+        out("  -> load-misaligned: faulting addr = mtval = 0x%08X, so s1(old g_running) = 0x%08X\n"
+            % (fmtval, (fmtval - 4) & 0xFFFFFFFF))
+
+    out("\n===== fault trap frame (frame_sp from trap ring last entry) =====\n")
+    n = rd32(TR_CNT)
+    last_idx = (n - 1) & 7
+    fsp = rd32(TR_RING + last_idx * 16 + 8)
+    out("  frame_sp=0x%08X (trap ring last)\n" % fsp)
+    if fsp and 0x3fc00000 <= fsp <= 0x3fcfffff:
+        out("    ra (x1)  @+0x00 = 0x%08X\n" % rd32(fsp + 0x00))
+        out("    s0 (x8)  @+0x18 = 0x%08X\n" % rd32(fsp + 0x18))
+        out("    s1 (x9)  @+0x1C = 0x%08X   <- s1 at fault (= g_running cur)\n" % rd32(fsp + 0x1C))
+        out("    s2 (x18) @+0x40 = 0x%08X\n" % rd32(fsp + 0x40))
+        out("    s3 (x19) @+0x44 = 0x%08X\n" % rd32(fsp + 0x44))
+        out("    s4 (x20) @+0x48 = 0x%08X\n" % rd32(fsp + 0x48))
+        out("    a0 (x10) @+0x20 = 0x%08X\n" % rd32(fsp + 0x20))
+        out("    mepc     @+0x78 = 0x%08X\n" % rd32(fsp + 0x78))
+        out("    mstatus  @+0x7C = 0x%08X\n" % rd32(fsp + 0x7C))
+
+    out("\n===== RISC-V trap ring (%d traps) =====\n" % n)
+    for i in range(8):
+        idx = (n - 8 + i) & 7 if n >= 8 else i
+        mcause = rd32(TR_RING + idx * 16 + 0)
+        mepc   = rd32(TR_RING + idx * 16 + 4)
+        fsp2   = rd32(TR_RING + idx * 16 + 8)
+        out("  trap#%02d: mcause=0x%08X mepc=0x%08X frame_sp=0x%08X\n" % (i, mcause, mepc, fsp2))
+
+    out("\n===== RISC-V switch trace (%d switches) =====\n" % rd32(SW_CNT))
+    ns = rd32(SW_CNT)
+    for i in range(16):
+        idx = (ns - 16 + i) & 15 if ns >= 16 else i
+        cur_name = rd32(SW_TRACE + idx * 16 + 0)
+        old_sp   = rd32(SW_TRACE + idx * 16 + 4)
+        nxt_name = rd32(SW_TRACE + idx * 16 + 8)
+        nxt_sp   = rd32(SW_TRACE + idx * 16 + 12)
+        out("  sw#%02d: %-8s -> %-8s  old_sp=0x%08X nxt_sp=0x%08X\n" % (
+            i, cstr(cur_name), cstr(nxt_name), old_sp, nxt_sp))
+
+    g = rd32(G_RUNNING)
+    out("\ng_running=0x%08X\n" % g)
+    SZT = 0x64   # sizeof(task_t)=100 (.bss sequential)
+    for i in range(12):
+        base = G_TASK_POOL + i * SZT
+        nm = rd32(base + 4)      # name @ +4
+        sp = rd32(base + 0)      # sp @ +0
+        st = rd8(base + 11)      # state @ +11
+        prio = rd8(base + 8)
+        tag = ""
+        if g == base:
+            tag = "  <<< g_running"
+        out("  pool[%02d] @0x%08X prio=%-3d state=%-2d sp=0x%08X name=\"%s\"%s\n" % (
+            i, base, prio, st, sp, cstr(nm), tag))
+
+    out("\n===== dump done =====\n")
+except Exception:
+    _f.write("\n===== PYTHON EXCEPTION =====\n")
+    _f.write(traceback.format_exc())
+    _f.flush()
+finally:
+    _f.close()
diff --git a/tools/renode/esp32c3_jos.repl b/tools/renode/esp32c3_jos.repl
new file mode 100644
index 0000000..f18d449
--- /dev/null
+++ b/tools/renode/esp32c3_jos.repl
@@ -0,0 +1,54 @@
+// esp32c3_jos.repl - jOS firmware platform for Renode (ESP32-C3 RISC-V)
+//
+// Self-contained platform description: no stock Renode ESP32-C3 model exists.
+// All peripherals are either generic Renode models or Tag placeholders.
+//
+// Emulated peripherals:
+//   - CPU: RiscV32 (rv32imc_zicsr_zifencei)
+//   - DRAM: 192 KB @ 0x3FC80000 (.data/.bss/stack/heap)
+//   - IRAM: 192 KB @ 0x40380000 (.text/.rodata/RTOS segments)
+//   - APP_FLASH: 2 MB @ 0x40200000 (memory-mapped, app_slot_boot.c probe)
+//   - PLIC: PlatformLevelInterruptController @ 0x0C000000 (1 context, M-mode)
+//   - CLINT: CoreLevelInterruptor @ 0x02000000 (timer + software IPI)
+//   - UART0: NS16550 @ 0x60000000 (firmware console)
+//   - GPIO: Tag placeholder @ 0x60004000 (no model needed in Phase-1)
+//
+// APP_RAM (0x3FCAF000, 4 KB) and APP_SLOT_RAM (0x3FCAFC00, 1 KB) are within
+// the DRAM region — no separate memory blocks needed.
+//
+// CPU clock: set via `cpu PerformanceInMips 40` in .resc
+
+/* ==================== CPU ==================== */
+
+cpu: CPU.RiscV32 @ sysbus
+    cpuType: "rv32imc_zicsr_zifencei"
+    timeProvider: clint
+
+/* ==================== Memory ==================== */
+
+sram: Memory.MappedMemory @ sysbus 0x3FC80000
+    size: 0x00030000
+
+iram: Memory.MappedMemory @ sysbus 0x40380000
+    size: 0x00030000
+
+app_flash: Memory.MappedMemory @ sysbus 0x40200000
+    size: 0x00180000
+
+/* ==================== Interrupt Controller ==================== */
+
+plic: IRQControllers.PlatformLevelInterruptController @ sysbus 0x0C000000
+    0 -> cpu@11
+    numberOfSources: 48
+    numberOfContexts: 1
+
+clint: IRQControllers.CoreLevelInterruptor  @ sysbus 0x02000000
+    [0,1] -> cpu@[3,7]
+    frequency: 10000000
+
+/* ==================== UART ==================== */
+
+uart0: UART.NS16550 @ sysbus 0x60000000
+    IRQ -> plic@13
+
+/* GPIO @ 0x60004000: Phase 1 has no GPIO model (UART uses dedicated pins) */
\ No newline at end of file
diff --git a/tools/renode/esp32c3_jos.resc b/tools/renode/esp32c3_jos.resc
new file mode 100644
index 0000000..0a4325f
--- /dev/null
+++ b/tools/renode/esp32c3_jos.resc
@@ -0,0 +1,33 @@
+# esp32c3_jos.resc - boot jOS firmware on ESP32-C3 (RISC-V) in Renode
+#
+# Minimal run: loads firmware ELF, starts simulation, checks UART output.
+#
+# Usage:
+#   cd D:\soft\Renode
+#   .\renode.exe --disable-xwt --console -e "include @d:/projects/mcu/os/joc-base/tools/renode/esp32c3_jos.resc" > c3_run.log 2>&1
+#
+# Build the firmware first:
+#   mkdir build_esp32c3 && cd build_esp32c3
+#   cmake .. -DJOC_TARGET=ESP32C3 -DRENODE=ON -DTOOLCHAIN_PREFIX=riscv32-esp-elf
+#   ninja
+#
+# The resulting jOS.elf is loaded directly into IRAM/DRAM by LoadELF.
+
+mach create
+machine LoadPlatformDescription @d:/projects/mcu/os/joc-base/tools/renode/esp32c3_jos.repl
+
+# attach the UART capture hook (echoes firmware console to stdout)
+include @d:/projects/mcu/os/joc-base/tools/renode/uart_capture.py
+
+# load the firmware (build with -DJOC_TARGET=ESP32C3 -DRENODE=ON -DTOOLCHAIN_PREFIX=riscv32-esp-elf)
+sysbus LoadELF @d:/projects/mcu/os/joc-base/build_esp32c3/jOS.elf
+
+# CPU performance: 40 MIPS matches Renode default 40 MHz RiscV32 core at IPC ~1
+cpu PerformanceInMips 40
+
+start
+sleep 3
+# send PING/TICKS/ECHO commands to verify console is alive
+include @d:/projects/mcu/os/joc-base/tools/renode/send_cmd.py
+sleep 5
+quit
\ No newline at end of file
