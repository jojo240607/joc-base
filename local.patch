-static inline int arch_in_priv(void) {
-    uint32_t ctrl;
-    __asm__ volatile("mrs %0, CONTROL" : "=r"(ctrl));
-    return ((ctrl & 0x1u) == 0u);   /* nPRIV=0 => 特权 */
-}
-
