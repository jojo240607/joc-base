+static const uart_config_t g_uart0 = {
+    .name       = "uart0",
+    .periph     = (void *)USART1,
+    .baud       = 115200,
+    .is_console = 1,
+    .tx_signal  = "USART1_TX",         /* TX = PA9, AF7 (ST-LINK VCOM) */
+    .rx_signal  = "USART1_RX",         /* RX = PA10, AF7 */
+    .dma_tx_req = DMA_REQ_USART1_TX,
+    .dma_rx_req = DMA_REQ_USART1_RX,
+    .engine     = STREAM_MODE_DMA,
