diff --git a/src/rtos/core/kobj.c b/src/rtos/core/kobj.c
index 5a9ef8f..2e770bd 100644
--- a/src/rtos/core/kobj.c
+++ b/src/rtos/core/kobj.c
@@ -20,7 +20,9 @@
  * 决定，而非“历史上创建过的全部任务”。128 给稳健模块(如 RTOSROBUST 的
  * 32 个 filler 任务瞬时共存)留足余量，避免注册表在 RTOSALL 中途溢出、导致
  * 后续模块(尤其唯一走 SVC 门校验的 RTOSUSR)的 IPC 对象登记失败而误判。 */
