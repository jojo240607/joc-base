{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build", "--target", "stm32f407_minimal.elf", "-j4"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake Configure",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-G", "Ninja"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash (ST-Link)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/flash.bat",
      "problemMatcher": []
    },
    {
      "label": "Start ST-Link GDB Server",
      "type": "shell",
      "command": "${workspaceFolder}/tools/start_gdbserver.bat",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
