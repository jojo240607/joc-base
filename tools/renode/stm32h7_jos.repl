// stm32h7_jos.repl - jOS firmware platform for Renode (self-contained)
//
// VENDORED + MODIFIED copy of the stock Renode 1.16 platform file
// (platforms/cpus/stm32h743.repl). STM32H750VBT6 shares the H743 core/M7,
// NVIC, DTCM (128K), AXI SRAM (512K) and QUADSPI memory-mapped region; it
// differs only in internal flash size (128K) and peripheral count.
//
// Differences vs the stock platform:
//   1. nvic systickFrequency: 480 MHz (matches RTOS_CPU_HZ=480000000).
//   2. usart1 IRQ wired DIRECTLY to nvic@37 (USART1_IRQn) - same pattern as
//      the F1/F4 jOS repls; the stock file routes it through EXTI.
//   3. qspiMemory: Memory.MappedMemory @ 0x90000000 (16 MB) - the Rust app
//      is LoadBinary'd here and executed XIP. The JOC_RENODE build skips all
//      QUADSPI register programming (qspi_hal_init_mm() is a no-op).
//   4. RCC model replaced by Tags (F1/F4 pattern): RCC_CR reports
//      HSEON|HSERDY|PLL1ON|PLL1RDY and RCC_CFGR reports SWS=PLL1, so the
//      firmware's bounded clock polls (clock_hal_configure) succeed at once.
//   5. FLASH_ACR tag absorbs the 2WS+WRHIGHFREQ write (M1 does no flash
//      programming, so no MTD flash controller model is needed).
//   6. DWT omitted: the H750 build defines __DWT_PRESENT=0U, so
//      rtos_cycle_now() returns 0 without touching 0xE0001000.
//
// The CPU CORE CLOCK: Renode does not model a core frequency; `cpu
// PerformanceInMips <N>` in the .resc caps emulated speed (480 matches a
// real 480 MHz core at IPC ~1; lower values are fine, functionality is
// unaffected). All timing the firmware uses IS at real frequencies: SysTick
// 480 MHz via nvic systickFrequency, timers 10 MHz, IWDG 32 kHz.

/* ==================== Memory & Bus ==================== */

// DTCM 128K @ 0x20000000: RTOS .data/.bss + task stacks + MSP stack top 0x20020000
dtcm: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

// AXI SRAM 512K @ 0x24000000: APP_RAM (Rust app runtime .data/.bss)
axiSram: Memory.MappedMemory @ sysbus 0x24000000
    size: 0x80000

// Internal flash 128K @ 0x08000000: RTOS firmware (XIP, read-only in M1)
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x20000

// QSPI memory-mapped 16M @ 0x90000000: Rust app (app_h750.bin, XIP)
qspiMemory: Memory.MappedMemory @ sysbus 0x90000000
    size: 0x1000000

// SRAM1 128K @ 0x30000000: non-cacheable heap (DMA-coherent via MPU)
sram1: Memory.MappedMemory @ sysbus 0x30000000
    size: 0x20000

/* ==================== UART ==================== */

usart1: UART.STM32F7_USART @ sysbus 0x40011000
    frequency: 120000000
    IRQ -> nvic@37

usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 120000000
    IRQ -> exti@27

usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 120000000
    IRQ -> exti@28

uart4: UART.STM32F7_USART @ sysbus 0x40004C00
    frequency: 120000000
    IRQ -> exti@30

uart5: UART.STM32F7_USART @ sysbus 0x40005000
    frequency: 120000000
    IRQ -> exti@31

/* ==================== Interrupt Controller & CPU ==================== */

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 480000000
    priorityMask: 0xF0
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m7"
    numberOfMPURegions: 16
    nvic: nvic

/* ==================== EXTI ==================== */

exti: IRQControllers.STM32H7_EXTI @ sysbus 0x58000000
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]
    [16-19] -> nvic@[1, 41, 2, 3]
    [20, 21] -> nvicInput137@[0-1]
    [22-24] -> nvic@[31, 33, 72]
    [26-29] -> nvic@[37-39, 71]
    [30-33] -> nvic@[52, 53, 82, 83]
    [34-35] -> nvicInput142@[0-1]
    [36-40] -> nvic@[35, 36, 51, 84, 85]
    41 -> nvicInput86@0
    [42-44] -> nvic@[119, 76, 100]
    [47, 48, 50, 52, 53] -> nvic@[93, 138-141]
    54 -> nvic@115
    [55-60] -> nvicInput149@[0-5]
    [61-64] -> nvic@[5, 95, 96, 142]
    65 -> nvicInput86@1
    [66-73] -> nvic@[129-136]
    [74-76] -> nvic@[128, 127, 146]
    [85, 86] -> nvic@[94, 61]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

nvicInput86: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@86

nvicInput137: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@137

nvicInput142: Miscellaneous.CombinedInput @ none
    numberOfInputs: 2
    -> nvic@142

nvicInput149: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@149

syscfg: Miscellaneous.STM32_SYSCFG @ sysbus 0x58000400
    [0-15] -> exti@[0-15]

/* ==================== GPIO (AHB4, F4-identical registers) ==================== */

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x58020000, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[5, 3], [7, 1, 3]]
    [0-15] -> syscfg#0@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x58020400, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[0, 1, 3], [1, 1, 3], [6, 1], [7, 1], [13, 1], [14, 1, 3], [15, 1, 3]]
    [0-15] -> syscfg#1@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x58020800, +0x400>
    numberOfAFs: 16
    [0-15] -> syscfg#2@[0-15]

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x58020C00, +0x400>
    numberOfAFs: 16
    [0-15] -> syscfg#3@[0-15]

gpioPortE: GPIOPort.STM32_GPIOPort @ sysbus <0x58021000, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[4, 4], [8, 1], [10, 1], [12, 1]]
    [0-15] -> syscfg#4@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x58021400, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[8, 1], [9, 1]]
    [0-15] -> syscfg#5@[0-15]

gpioPortG: GPIOPort.STM32_GPIOPort @ sysbus <0x58021800, +0x400>
    numberOfAFs: 16
    [0-15] -> syscfg#6@[0-15]

gpioPortH: GPIOPort.STM32_GPIOPort @ sysbus <0x58021C00, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[13, 3], [14, 3], [15, 3]]
    [0-15] -> syscfg#7@[0-15]

gpioPortI: GPIOPort.STM32_GPIOPort @ sysbus <0x58022000, +0x400>
    numberOfAFs: 16
    [0-15] -> syscfg#8@[0-15]

gpioPortJ: GPIOPort.STM32_GPIOPort @ sysbus <0x58022400, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[7, 3], [8, 1], [9, 3], [10, 1], [11, 3]]
    [0-15] -> syscfg#9@[0-15]

gpioPortK: GPIOPort.STM32_GPIOPort @ sysbus <0x58022800, +0x400>
    numberOfAFs: 16
    invertedAFPins: [[0, 1], [1, 3]]
    [0-7] -> syscfg#10@[0-7]

/* ==================== Timers (H750 IRQ numbers) ==================== */

timer1: Timers.STM32_Timer @ sysbus 0x40010000
    BreakInterrupt -> nvic@24
    UpdateInterrupt -> nvic@25
    [TriggerInterrupt, CommutationInterrupt] -> nvic@[26, 26]
    CaptureCompareInterrupt -> nvic@27
    frequency: 10000000
    initialLimit: 0xFFFF

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    -> nvic@28
    frequency: 10000000
    initialLimit: 0xFFFFFFFF

timer3: Timers.STM32_Timer @ sysbus 0x40000400
    -> nvic@29
    frequency: 10000000
    initialLimit: 0xFFFF

timer4: Timers.STM32_Timer @ sysbus 0x40000800
    -> nvic@30
    frequency: 10000000
    initialLimit: 0xFFFF

timer5: Timers.STM32_Timer @ sysbus 0x40000C00
    -> nvic@50
    frequency: 10000000
    initialLimit: 0xFFFFFFFF

timer6: Timers.STM32_Timer @ sysbus 0x40001000
    -> nvic@54
    frequency: 10000000
    initialLimit: 0xFFFF

timer7: Timers.STM32_Timer @ sysbus 0x40001400
    -> nvic@55
    frequency: 10000000
    initialLimit: 0xFFFF

timer8: Timers.STM32_Timer @ sysbus 0x40010400
    BreakInterrupt -> nvic@43
    UpdateInterrupt -> nvic@44
    [TriggerInterrupt, CommutationInterrupt] -> nvic@[45, 45]
    CaptureCompareInterrupt -> nvic@46
    frequency: 10000000
    initialLimit: 0xFFFF

timer12: Timers.STM32_Timer @ sysbus 0x40001800
    -> nvic@43
    frequency: 10000000
    initialLimit: 0xFFFF

timer13: Timers.STM32_Timer @ sysbus 0x40001C00
    -> nvic@44
    frequency: 10000000
    initialLimit: 0xFFFF

timer14: Timers.STM32_Timer @ sysbus 0x40002000
    -> nvic@45
    frequency: 10000000
    initialLimit: 0xFFFF

timer15: Timers.STM32_Timer @ sysbus 0x40014000
    -> nvic@116
    frequency: 10000000
    initialLimit: 0xFFFF

timer16: Timers.STM32_Timer @ sysbus 0x40014400
    -> nvic@117
    frequency: 10000000
    initialLimit: 0xFFFF

timer17: Timers.STM32_Timer @ sysbus 0x40014800
    -> nvic@118
    frequency: 10000000
    initialLimit: 0xFFFF

/* ==================== FDCAN ==================== */

fdcan1: CAN.MCAN @ sysbus 0x4000A000
    Line0 -> nvic@19
    Line1 -> nvic@21
    Calibration -> nvic@63
    messageRAM: canMessageRAM

fdcan2: CAN.MCAN @ sysbus 0x4000A400
    Line0 -> nvic@20
    Line1 -> nvic@22
    Calibration -> nvic@63
    messageRAM: canMessageRAM

canMessageRAM: Memory.ArrayMemory @ sysbus <0x4000AC00, +0x2800>
    size: 0x2800

/* ==================== SPI / I2C ==================== */

spi1: SPI.STM32H7_SPI @ sysbus 0x40013000
spi2: SPI.STM32H7_SPI @ sysbus 0x40003800
spi3: SPI.STM32H7_SPI @ sysbus 0x40003C00
spi4: SPI.STM32H7_SPI @ sysbus 0x40013400

i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt -> exti@22
    ErrorInterrupt -> nvic@32

i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
    EventInterrupt -> exti@23
    ErrorInterrupt -> nvic@34

i2c3: I2C.STM32F7_I2C @ sysbus 0x40005C00
    EventInterrupt -> exti@24
    ErrorInterrupt -> nvic@73

/* ==================== DMA ==================== */

dma1: DMA.STM32DMA @ sysbus 0x40020000
    [0-7] -> nvic@[11-17, 47]

dma2: DMA.STM32DMA @ sysbus 0x40020400
    [0-7] -> nvic@[56-60, 68-70]

dmamux1: Miscellaneous.STM32_DMAMUX @ sysbus 0x40020800
    numberOfOutputRequestChannels: 16
    numberOfRequestGeneratorChannels: 8
    [0-7] -> dma1@[0-7]
    [8-15] -> dma2@[0-7]

/* ==================== Watchdog / RTC / CRC ==================== */

watchdog: Timers.STM32_IndependentWatchdog @ sysbus 0x58004800
    frequency: 32000
    windowOption: false
    defaultPrescaler: 0x4

rtc: Timers.STM32F4_RTC @ sysbus 0x58004000
    AlarmIRQ -> exti@17
    WakeupIRQ -> exti@19

crc: CRC.STM32_CRC @ sysbus 0x58024C00
    series: STM32Series.F0
    configurablePoly: true

/* ==================== jOS additions ==================== */

// (none: DWT deliberately omitted, see header comment)

/* ==================== sysbus init ==================== */

sysbus:
    init:
        // RCC_CR: HSEON|HSERDY|PLL1ON|PLL1RDY pre-set so the firmware's
        // clock_hal_configure() HSE/PLL1 ready polls succeed immediately
        // (the STM32H7_RCC model is not used - Tags only, F1/F4 pattern).
        Tag <0x58024400, 0x58024403> "RCC_CR" 0x03030000
        // RCC_CFGR: report SYSCLK=PLL1 (SWS=0b011) so the final SW-switch
        // poll in clock_hal_configure() completes at once.
        Tag <0x58024410, 0x58024413> "RCC_CFGR" 0x18
        // RCC_OTHER: absorb all remaining RCC writes/reads (D1/D2/D3CFGR,
        // PLLCKSELR/PLL1DIVR, AHBxENR/APBxENR gates, RSR reset flags, ...).
        // Reads return 0: board_report_reset_reason() sees a clean POR.
        Tag <0x58024414, 0x580244FF> "RCC_OTHER"
        // PWR D3CR: VOSRDY (b13) set - firmware's VOS0 wait succeeds.
        // (M1 firmware only touches D3CR; the rest of PWR is never written.)
        Tag <0x58024818, 0x58024818> "D3CR" 0x2000
        // FLASH ACR: absorb the 2WS|WRHIGHFREQ write (M1 does no flash
        // programming, so no MTD.STM32H7_FlashController model is required).
        Tag <0x52002000, 0x52002003> "FLASH_ACR" 0x22
